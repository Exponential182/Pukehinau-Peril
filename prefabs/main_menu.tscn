[sub_resource type="GDScript" id="GDScript_dgjvs"]
script/source = "extends Control


func _on_start_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://prefabs/main_level.tscn\")


func _on_brain_button_pressed() -> void:
	$brawn_button.button_pressed = false


func _on_brawn_button_pressed() -> void:
	$brain_button.button_pressed = false
"

